PORT=3000
DB_CONNECT=mongodb://127.0.0.1:27017/veloxride
JWT_SECRET=replace-with-a-long-random-string
GOOGLE_MAPS_API=your-google-maps-server-key
# Frontend origin allowed by CORS / Socket.IO (leave empty to allow all during development)
CLIENT_URL=http://localhost:5173

# Razorpay (optional). Leave empty and the app works with cash only.
# Test keys: https://dashboard.razorpay.com/app/keys (switch to Test Mode)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
