PORT=3000
DB_CONNECT=mongodb://127.0.0.1:27017/veloxride
JWT_SECRET=replace-with-a-long-random-string
GOOGLE_MAPS_API=your-google-maps-server-key
# Frontend origin(s) allowed by CORS / Socket.IO, comma-separated.
# Leave empty to allow all during development.
CLIENT_URL=http://localhost:5173

# Set to 1 when running behind a hosting proxy (Render). Leave empty locally.
TRUST_PROXY=

# Razorpay (optional). Leave empty and the app works with cash only.
# Test keys: https://dashboard.razorpay.com/app/keys (switch to Test Mode)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
